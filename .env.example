# Copy this file to .env.local and replace the example values.
DB_SERVER=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_DATABASE=NiaData
# Leave both blank to use Windows trusted authentication on a local SQL Server.
DB_USER=
DB_PASSWORD=

# Use true for Azure SQL. For a local SQL Server with a self-signed certificate,
# DB_TRUST_SERVER_CERTIFICATE=true is usually required during development.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Optional pool settings
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000

# OTP delivery. Keep all values server-side; do not use a NEXT_PUBLIC_ prefix.
# In development, every generated OTP is also printed in the `npm run dev`
# terminal. Keep this false or unset outside controlled testing.
OTP_LOG_TO_CONSOLE=false
# Email can use a Brevo REST API key (preferred) or an SMTP credential.
BREVO_SMTP_KEY=
# Optional. Defaults to BREVO_FROM_EMAIL when omitted.
BREVO_SMTP_USER=
# Must be a sender email address verified in Brevo.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Motor Insurance
# Used for the Brevo email REST API when present.
BREVO_API_KEY=

# Aeris SMS endpoint and credentials. Use the endpoint only (no query string);
# the server supplies phone_number, sms_text, camp_name, app_id, and app_key safely.
AERIS_SMS_ENDPOINT=https://www.aerislive.com/api/api/sendSmsUrl
AERIS_SMS_CAMPAIGN=motor_insurance_otp
AERIS_SMS_APP_ID=
AERIS_SMS_APP_KEY=
